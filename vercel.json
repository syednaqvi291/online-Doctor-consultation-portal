{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "careconnect/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/js/(.*)",
      "dest": "careconnect/js/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "careconnect/css/$1"
    },
    {
      "src": "/(.*)",
      "dest": "careconnect/$1"
    }
  ]
}