{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "careconnect/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/auth/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/api/appointments/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/api/ai/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "careconnect/$1"
    }
  ]
}